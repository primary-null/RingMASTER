[Desktop Entry]
Name=RingMASTER
Comment=RingMASTER desktop infrastructure client
Exec=/opt/ringmaster/bin/ringmaster
Icon=ringmaster
Terminal=false
Type=Application
Categories=System;
# StartupWMClass matches the X11 class JDK 21 derives from local.ringleader.desktop.MainKt (dots become hyphens).
StartupWMClass=local-ringleader-desktop-MainKt
